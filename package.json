{
  "name": "houzzat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:next": "WATCHPACK_POLLING=true next dev --hostname 127.0.0.1 --webpack",
    "dev:db": "prisma dev start houzzat -d",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node --import tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "mls:sync": "node --import tsx scripts/mls-sync.ts",
    "mls:media": "node --import tsx scripts/mls-media-backfill.ts",
    "mls:geocode": "node --import tsx scripts/mls-geocode.ts",
    "mls:geocode:loop": "node --import tsx scripts/mls-geocode-loop.ts",
    "mls:refresh": "node --import tsx scripts/mls-refresh.ts",
    "mls:rooms": "node --import tsx scripts/mls-rooms-backfill.ts",
    "mls:history": "node --import tsx scripts/mls-history-backfill.ts",
    "poi:sync": "node --import tsx scripts/poi-sync.ts",
    "roles:migrate": "node --import tsx scripts/migrate-roles.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "build:cloudflare": "opennextjs-cloudflare build",
    "deploy": "pnpm build:cloudflare && opennextjs-cloudflare deploy",
    "deploy:cf": "pnpm build:cloudflare && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.21.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.2.9",
    "next-auth": "5.0.0-beta.31",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.14.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@prisma/adapter-pg": "^7.8.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "wrangler": "^4.104.0"
  },
  "pnpm": {
    "overrides": {
      "@auth/core": "0.41.3"
    },
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "esbuild",
      "workerd",
      "sharp"
    ],
    "supportedArchitectures": {
      "os": [
        "darwin",
        "linux"
      ],
      "cpu": [
        "x64",
        "arm64"
      ]
    }
  }
}
