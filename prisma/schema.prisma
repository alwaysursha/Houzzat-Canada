  @@index([createdAt])
  @@index([visitorId, createdAt])
  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([mlsNumber, createdAt])
}

/**
 * Admin action audit trail.
 */
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  summary    String
  meta       Json?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

/**
 * Stage 6.1 — HouzzatPRO SaaS control plane.
 * HARD RULE: PlatformOperator does NOT authorize tenant CRM access and must
 * never auto-create WorkspaceMember. Isolation is via platform services only.
 */

model PlatformOperator {
  id                  String                 @id @default(cuid())
  userId              String                 @unique
  role                PlatformOperatorRole   @default(MASTER_ADMIN)
  status              PlatformOperatorStatus @default(ACTIVE)
  createdByOperatorId String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  user                    User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdByOperator       PlatformOperator?          @relation("PlatformOperatorCreatedBy", fields: [createdByOperatorId], references: [id], onDelete: SetNull)
  createdOperators        PlatformOperator[]         @relation("PlatformOperatorCreatedBy")
  ownedProspects          PlatformProspect[]         @relation("ProspectOwner")
  prospectActivities      PlatformProspectActivity[]
  offersCreated           CommercialOffer[]          @relation("OfferCreator")
  statusEvents            WorkspaceStatusEvent[]
  auditEvents             PlatformAuditEvent[]
  ownerActivationsCreated WorkspaceOwnerActivation[] @relation("OwnerActivationCreator")
  smsAutomationVersionsCreated   SmsAutomationVersion[] @relation("SmsAutomationVersionCreatedBy")
  smsAutomationVersionsPublished SmsAutomationVersion[] @relation("SmsAutomationVersionPublishedBy")
  smsQuickTextsCreated           SmsQuickText[]         @relation("SmsQuickTextCreatedBy")
  smsQuickTextsUpdated           SmsQuickText[]         @relation("SmsQuickTextUpdatedBy")

  @@index([status, role])
}

model PlatformProspect {
  id                String         @id @default(cuid())
  businessName      String?
  contactName       String
  /**
   * Normalized lowercase email — globally unique; reopen LOST rather than duplicate.
   */
  email             String         @unique
  phone             String?
  brokerageName     String?
  estimatedTeamSize Int?
  region            String?
  website           String?
  source            ProspectSource @default(WEBSITE_DEMO)
  status            ProspectStatus @default(NEW)
  ownerOperatorId   String?
  notesInternal     String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  ownerOperator    PlatformOperator?          @relation("ProspectOwner", fields: [ownerOperatorId], references: [id], onDelete: SetNull)
  activities       PlatformProspectActivity[]
  offers           CommercialOffer[]
  billingCustomers BillingCustomer[]

  @@index([status, email])
  @@index([ownerOperatorId])
}

model PlatformProspectActivity {
  id          String               @id @default(cuid())
  prospectId  String
  type        ProspectActivityType
  scheduledAt DateTime?
  completedAt DateTime?
  operatorId  String?
  body        String?
  createdAt   DateTime             @default(now())

  prospect PlatformProspect  @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  operator PlatformOperator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([prospectId, createdAt])
}

model CommercialOffer {
  id                             String         @id @default(cuid())
  prospectId                     String
  createdByOperatorId            String
  status                         OfferStatus    @default(DRAFT)
  planCode                       PlanCode
  billingCadence                 BillingCadence
  currency                       String         @default("CAD")
  standardRecurringAmountCents   Int
  negotiatedRecurringAmountCents Int
  setupFeeCents                  Int
  includedSeats                  Int
  additionalSeats                Int            @default(0)
  trialDays                      Int?
  proposedStartDate              DateTime?
  expiresAt                      DateTime?
  version                        Int            @default(1)
  acceptedSnapshotJson           Json?
  sentAt                         DateTime?
  viewedAt                       DateTime?
  acceptedAt                     DateTime?
  acceptedByEmail                String?
  /**
   * Set only after provisioning creates the workspace (unique when present).
   */
  workspaceId                    String?        @unique
  createdAt                      DateTime       @default(now())
  updatedAt                      DateTime       @updatedAt

  prospect          PlatformProspect          @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  createdByOperator PlatformOperator          @relation("OfferCreator", fields: [createdByOperatorId], references: [id], onDelete: Restrict)
  workspace         Workspace?                @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  lineItems         CommercialOfferLineItem[]
  tokens            CommercialOfferToken[]
  acceptance        OfferAcceptance?
  subscription      Subscription?
  addOnGrants       AddOnGrant[]
  provisioningRun   ProvisioningRun?

  @@index([status, expiresAt])
  @@index([prospectId, status])
}

model CommercialOfferLineItem {
  id          String        @id @default(cuid())
  offerId     String
  kind        OfferLineKind
  code        String
  description String
  amountCents Int
  isRecurring Boolean
  quantity    Int           @default(1)
  metadata    Json?
  sortOrder   Int           @default(0)

  offer CommercialOffer @relation(fields: [offerId], references: [id], onDelete: Restrict)

  @@index([offerId, sortOrder])
}

model CommercialOfferToken {
  id           String    @id @default(cuid())
  offerId      String
  /**
   * SHA-256 of raw token — never store raw token.
   */
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())

  offer CommercialOffer @relation(fields: [offerId], references: [id], onDelete: Restrict)

  @@index([offerId])
}

model OfferAcceptance {
  id                          String   @id @default(cuid())
  offerId                     String   @unique
  acceptedAt                  DateTime
  acceptedEmail               String
  termsVersion                String
  privacyVersion              String
  billingAuthorizationVersion String?
  commercialTermsHash         String
  ipAddress                   String?
  userAgent                   String?

  offer CommercialOffer @relation(fields: [offerId], references: [id], onDelete: Restrict)
}

model BillingCustomer {
  id               String             @id @default(cuid())
  prospectId       String?
  workspaceId      String?            @unique
  email            String
  stripeCustomerId String?            @unique
  source           SubscriptionSource
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  prospect      PlatformProspect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  workspace     Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  subscriptions Subscription[]

  @@index([email])
}

/**
 * Canonical application billing record.
 * workspaceId is NOT unique — history of many subscriptions per workspace.
 * Current operational sub is Workspace.currentSubscriptionId.
 */
model Subscription {
  id                      String             @id @default(cuid())
  workspaceId             String?
  /**
   * Originating accepted offer (unique when set). Null for grandfathered/internal.
   */
  offerId                 String?            @unique
  billingCustomerId       String
  source                  SubscriptionSource
  status                  SubscriptionStatus
  /**
   * Required logically for STRIPE SaaS; null for GRANDFATHERED/INTERNAL.
   */
  planCode                PlanCode?
  entitlementProfileCode  String?
  billingCadence          BillingCadence?
  currency                String             @default("CAD")
  recurringAmountCents    Int?
  setupFeeCents           Int?
  includedSeats           Int
  additionalSeats         Int                @default(0)
  stripeSubscriptionId    String?            @unique
  stripePriceId           String?
  stripeCheckoutSessionId String?            @unique
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  cancelAtPeriodEnd       Boolean            @default(false)
  trialEndsAt             DateTime?
  pastDueSince            DateTime?
  canceledAt              DateTime?
  commercialSnapshotJson  Json
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  workspace           Workspace?       @relation("WorkspaceSubscriptions", fields: [workspaceId], references: [id], onDelete: SetNull)
  currentForWorkspace Workspace?       @relation("WorkspaceCurrentSubscription")
  offer               CommercialOffer? @relation(fields: [offerId], references: [id], onDelete: Restrict)
  billingCustomer     BillingCustomer  @relation(fields: [billingCustomerId], references: [id], onDelete: Restrict)
  provisioningRun     ProvisioningRun?

  @@index([status, workspaceId])
  @@index([workspaceId])
}

model WorkspaceEntitlement {
  id          String            @id @default(cuid())
  workspaceId String
  featureCode String
  enabled     Boolean           @default(true)
  source      EntitlementSource
  grantId     String?
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, featureCode])
  @@index([workspaceId])
}

model WorkspaceSeatQuota {
  workspaceId     String   @id
  includedSeats   Int
  additionalSeats Int      @default(0)
  seatLimit       Int
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AddOnGrant {
  id               String           @id @default(cuid())
  workspaceId      String
  addOnCode        AddOnCode
  status           AddOnGrantStatus @default(PENDING_FULFILLMENT)
  sourceOfferId    String?
  startsAt         DateTime?
  endsAt           DateTime?
  fulfillmentNotes String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceOffer CommercialOffer? @relation(fields: [sourceOfferId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([workspaceId, addOnCode])
}

model ProvisioningRun {
  id             String                @id @default(cuid())
  offerId        String                @unique
  subscriptionId String                @unique
  workspaceId    String?               @unique
  status         ProvisioningRunStatus @default(PENDING)
  idempotencyKey String                @unique
  attemptCount   Int                   @default(0)
  lastError      String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  offer        CommercialOffer    @relation(fields: [offerId], references: [id], onDelete: Restrict)
  subscription Subscription       @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  workspace    Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  steps        ProvisioningStep[]
}

model ProvisioningStep {
  id           String                 @id @default(cuid())
  runId        String
  stepKey      String
  status       ProvisioningStepStatus @default(PENDING)
  attemptCount Int                    @default(0)
  lastError    String?
  outputRef    String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  run ProvisioningRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, stepKey])
  @@index([runId, stepKey])
}

model WorkspaceStatusEvent {
  id              String                    @id @default(cuid())
  workspaceId     String
  fromStatus      WorkspaceStatus
  toStatus        WorkspaceStatus
  reasonCode      WorkspaceStatusReasonCode
  reasonDetail    String?
  actorType       WorkspaceStatusActorType
  actorOperatorId String?
  createdAt       DateTime                  @default(now())

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actorOperator PlatformOperator? @relation(fields: [actorOperatorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}

/**
 * Platform commercial/ops audit.
 * NEVER STORE TENANT CRM PII OR CRM CONTENT HERE.
 */
model PlatformAuditEvent {
  id              String                 @id @default(cuid())
  actorOperatorId String?
  actorType       PlatformAuditActorType
  action          String
  entityType      String
  entityId        String
  summary         String
  metadata        Json?
  createdAt       DateTime               @default(now())

  actorOperator PlatformOperator? @relation(fields: [actorOperatorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorOperatorId, createdAt])
}

model WorkspaceEmailIdentity {
  workspaceId       String                     @id
  contactEmail      String?
  replyToEmail      String?
  senderDisplayName String?
  customDomain      String?
  domainStatus      WorkspaceEmailDomainStatus @default(NONE)
  dnsRecordsJson    Json?
  fallbackFrom      String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/**
 * Stage 6.10A — one-time hashed owner activation token.
 * Raw token exists only in email/URL. At most one usable token per workspace/user
 * is enforced in service logic (revoke prior PENDING/SENT on resend).
 */
model WorkspaceOwnerActivation {
  id                  String                         @id @default(cuid())
  workspaceId         String
  userId              String
  /**
   * SHA-256 hex of raw token — never store raw token.
   */
  tokenHash           String                         @unique
  status              WorkspaceOwnerActivationStatus @default(PENDING)
  expiresAt           DateTime
  sentAt              DateTime?
  usedAt              DateTime?
  revokedAt           DateTime?
  createdByType       PlatformAuditActorType         @default(OPERATOR)
  createdByOperatorId String?
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt

  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdByOperator PlatformOperator? @relation("OwnerActivationCreator", fields: [createdByOperatorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, userId, status])
  @@index([userId, status])
  @@index([expiresAt])
}

/**
 * Stage 6.10A — durable non-design onboarding progress.
 * templateThemeStatus stays NOT_STARTED until owner template design decision.
 */
model WorkspaceOnboardingState {
  workspaceId                String                        @id
  accountActivatedAt         DateTime?
  businessProfileStatus      WorkspaceOnboardingStepStatus @default(NOT_STARTED)
  brandingStatus             WorkspaceOnboardingStepStatus @default(NOT_STARTED)
  /**
   * Stage 6.11D — professional + brokerage identity step (does not lock website).
   */
  professionalIdentityStatus WorkspaceOnboardingStepStatus @default(NOT_STARTED)
  templateThemeStatus        WorkspaceOnboardingStepStatus @default(NOT_STARTED)
  emailIdentityStatus        WorkspaceOnboardingStepStatus @default(NOT_STARTED)
  completedAt                DateTime?
  updatedAt                  DateTime                      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/**
 * Platform-global SMS automation catalog. Tenants cannot override in V1.
 * Production execution uses the latest PUBLISHED version only.
 */
model SmsAutomationDefinition {
  id                    String                 @id @default(cuid())
  key                   String                 @unique
  name                  String
  recipient             SmsAutomationRecipient
  triggerKey            String
  description           String?
  active                Boolean                @default(true)
  replyEnabled          Boolean                @default(false)
  delayMinutes          Int?
  inactivityDays        Int?
  inactivityBucketsJson Json?
  allowedVariables      String[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  versions SmsAutomationVersion[]

  @@index([recipient, triggerKey])
  @@index([active])
}

model SmsAutomationVersion {
  id                    String                     @id @default(cuid())
  definitionId          String
  versionNumber         Int
  status                SmsAutomationVersionStatus
  body                  String                     @db.Text
  delayMinutes          Int?
  inactivityDays        Int?
  inactivityBucketsJson Json?
  createdAt             DateTime                   @default(now())
  createdByOperatorId   String?
  publishedAt           DateTime?
  publishedByOperatorId String?
  rollbackOfVersionId   String?

  definition  SmsAutomationDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  createdBy   PlatformOperator?       @relation("SmsAutomationVersionCreatedBy", fields: [createdByOperatorId], references: [id], onDelete: SetNull)
  publishedBy PlatformOperator?       @relation("SmsAutomationVersionPublishedBy", fields: [publishedByOperatorId], references: [id], onDelete: SetNull)

  @@unique([definitionId, versionNumber])
  @@index([definitionId, status])
  @@index([definitionId, publishedAt])
}

/**
 * Platform-global Quick Texts. Agents pick one to fill the composer; tenants
 * cannot edit in V1. Separate from SmsAutomationDefinition (auto-triggered).
 */
model SmsQuickText {
  id                  String   @id @default(cuid())
  key                 String   @unique
  name                String
  category            String
  body                String   @db.Text
  sortOrder           Int      @default(0)
  active              Boolean  @default(true)
  allowedVariables    String[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdByOperatorId String?
  updatedByOperatorId String?

  createdBy PlatformOperator? @relation("SmsQuickTextCreatedBy", fields: [createdByOperatorId], references: [id], onDelete: SetNull)
  updatedBy PlatformOperator? @relation("SmsQuickTextUpdatedBy", fields: [updatedByOperatorId], references: [id], onDelete: SetNull)

  @@index([active, sortOrder])
  @@index([category, sortOrder])
}

/**
 * Per-workspace SMS segment usage. No message body. Idempotent on Twilio SID.
 */
model SmsUsageEvent {
  id                  String                 @id @default(cuid())
  workspaceId         String
  periodStart         DateTime
  periodEnd           DateTime
  category            SmsUsageCategory
  recipientType       SmsUsageRecipientType
  twilioMessageSid    String?                @unique
  messageId           String?
  segmentCount        Int
  segmentCountSource  SmsSegmentCountSource
  finalized           Boolean                @default(false)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, periodStart, periodEnd])
  @@index([workspaceId, category])
  @@index([messageId])
}

/**
 * Confirmed Agent Mass SMS operation. Idempotent on workspace + agent + clientKey.
 * Recipients are processed through the existing per-Lead SMS transport.
 */
model SmsMassBatch {
  id                 String             @id @default(cuid())
  workspaceId        String
  agentUserId        String
  clientKey          String
  body               String             @db.Text
  status             SmsMassBatchStatus @default(PENDING)
  requestedCount     Int                @default(0)
  eligibleCount      Int                @default(0)
  excludedCount      Int                @default(0)
  successfulCount    Int                @default(0)
  failedCount        Int                @default(0)
  estimatedSegments  Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  workspace  Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipients SmsMassBatchRecipient[]

  @@unique([workspaceId, agentUserId, clientKey])
  @@index([workspaceId, createdAt])
  @@index([agentUserId, createdAt])
}

model SmsMassBatchRecipient {
  id               String                 @id @default(cuid())
  batchId          String
  leadId           String
  status           SmsMassRecipientStatus @default(PENDING)
  excludeReason    String?
  twilioMessageSid String?
  messageId        String?
  segmentCount     Int?
  errorCode        String?
  processedAt      DateTime?

  batch SmsMassBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, leadId])
  @@index([batchId, status])
  @@index([leadId])
}

/**
 * Idempotent SMS automation send. Unique per workspace + lead + key + cycle.
 * A cycle is one signup, unsubscribe transition, viewing request, inactivity
 * idle period, or return-from-inactivity event. Retries must not duplicate SENT.
 */
model SmsAutomationDispatch {
  id               String                       @id @default(cuid())
  workspaceId      String
  leadId           String
  automationKey    String
  cycleKey         String
  status           SmsAutomationDispatchStatus  @default(PENDING)
  twilioMessageSid String?
  messageId        String?
  errorCode        String?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  processedAt      DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, leadId, automationKey, cycleKey])
  @@index([workspaceId, createdAt])
  @@index([leadId, automationKey])
  @@index([status, createdAt])
}
