generator client {
  provider      = "prisma-client-js"
  engineType    = "client"
  compilerBuild = "small"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BUYER
  SELLER
  AGENT
  ADMIN
}

/**
 * Active consumer dashboard mode (ignored for ADMIN / AGENT).
 */
enum ActiveMode {
  BUYER
  SELLER
}

enum RelatedListingsMode {
  SAME_AREA
  SAME_FEATURES
}

enum LeadStatus {
  NEW_LEAD
  ATTEMPTED_CONTACT
  CONTACTED
  APPT_SET
  APPT_MET
  ACTIVE_CLIENT
  PENDING_CLIENT
  PAST_CLIENT
}

enum LeadSource {
  PROPERTY_INQUIRY
  SHOWING_REQUEST
  VIRTUAL_VIEWING
  HOME_VALUATION
  BUYER_SESSION
  SAVED_SEARCH
  LANDING_PAGE
  OPEN_HOUSE
  PAID_AD
  AFFORDABILITY
  SELLER_READINESS
  SIGNUP
  OTHER
}

/**
 * Buyer vs seller desk routing (buyer+seller → SELLER).
 */
enum LeadIntent {
  BUYER
  SELLER
}

/**
 * Workspace tag catalog origin. Buyer/Seller/Both are NOT catalog rows.
 */
enum WorkspaceTagOrigin {
  MANUAL
  IMPORTED
}

enum LeadImportJobStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum LeadImportRowStatus {
  PENDING
  CREATED
  SKIPPED
  FAILED
}

/**
 * Import-level default classification. BOTH = Lead.isBuyer+isSeller; intent stays SELLER.
 */
enum LeadImportDefaultType {
  BUYER
  SELLER
  BOTH
  DETECT
}

/**
 * How seller leads are auto-assigned.
 */
enum SellerLeadAssignMode {
  LISTING_AGENT
  PERCENTAGE
}

enum LeadRoutingLane {
  BUYER
  SELLER
}

/**
 * Agent-classified inquiry type on Contact Requested (Launchpad).
 */
enum InquiryTag {
  VIEWING
  HOME_VALUE
  PROPERTY_DETAILS
  GENERAL
}

/**
 * When the customer expects to buy or sell.
 */
enum PurchaseTimeframe {
  NOW
  ONE_TO_THREE_MONTHS
  SIX_TO_TWELVE_MONTHS
  TWELVE_PLUS_MONTHS
}

/**
 * Agent CRM follow-up note category.
 */
enum LeadNoteCategory {
  GENERAL
  CALL
}

/**
 * HouzzatPRO permanent Agent ↔ Lead thread. Not owned by an agent.
 */
enum ConversationStatus {
  OPEN
  BLOCKED
}

enum MessageChannel {
  CHAT
  SMS
}

enum MessageKind {
  TEXT
  SYSTEM_CARD
}

enum MessageSenderKind {
  CUSTOMER
  AGENT
  ADMIN
  SYSTEM
}

enum MessageSmsSource {
  TWILIO
  MANUAL
}

enum MessageRevisionAction {
  EDIT
  DELETE
}

enum MessageAttachmentKind {
  IMAGE
  VOICE_NOTE
}

enum AppointmentType {
  SHOWING
  VIRTUAL_VIEWING
  BUYER_SESSION
  VALUATION_CALL
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

/**
 * Seat role inside a selling Organization (team / brokerage). Not platform ADMIN.
 */
enum OrgMembershipRole {
  OWNER
  ADMIN
  AGENT
}

/**
 * Future multi-tenant workspace lifecycle (Stage 1 foundation — unused at runtime).
 */
enum WorkspaceStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

/**
 * Seat role inside a Workspace. Independent from User.role and OrgMembershipRole.
 */
enum WorkspaceMemberRole {
  OWNER
  ADMIN
  AGENT
}

enum WorkspaceMemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum WorkspaceInviteStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}

/**
 * Stage 3K.2 — hostname role within kind (CUSTOM primary/alias). PLATFORM uses PRIMARY.
 */
enum WorkspaceDomainRole {
  PRIMARY
  ALIAS
}

/**
 * Stage 3K.4.2 — platform-managed vs customer-owned hostname.
 */
enum WorkspaceDomainKind {
  PLATFORM
  CUSTOM
}

/**
 * Stage 3K.2 — hostname lifecycle.
 */
enum WorkspaceDomainStatus {
  PENDING
  ACTIVE
  DISABLED
}

/**
 * Stage 3K.2 — tenant web branding tier (entitlements wired later).
 */
enum BrandingTier {
  GENERIC
  SEMI_BRANDED
  FULL_BRANDED
}

/**
 * Stage 6.1 — HouzzatPRO SaaS control-plane enums.
 */

enum PlatformOperatorRole {
  MASTER_ADMIN
  SALES
  BILLING
}

enum PlatformOperatorStatus {
  ACTIVE
  DISABLED
}

enum ProspectStatus {
  NEW
  CONTACTED
  DEMO_SCHEDULED
  DEMO_COMPLETED
  OFFER_SENT
  WON
  LOST
}

enum ProspectActivityType {
  NOTE
  DEMO_SCHEDULED
  DEMO_COMPLETED
  DEMO_NO_SHOW
  DEMO_CANCELLED
  STATUS_CHANGE
  OFFER_LINKED
}

enum ProspectSource {
  WEBSITE_DEMO
  REFERRAL
  OUTBOUND
  OTHER
}

enum PlanCode {
  SOLO
  TEAM
  BROKERAGE
}

enum BillingCadence {
  MONTHLY
  ANNUAL
}

enum OfferStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum OfferLineKind {
  PLAN_BASE
  SETUP_FEE
  ADDITIONAL_SEAT
  ADDON
  DISCOUNT
  CUSTOM
}

enum SubscriptionSource {
  STRIPE
  INTERNAL
  GRANDFATHERED
}

/**
 * Billing/sync axis only — never Workspace operational status.
 */
enum SubscriptionStatus {
  PENDING_PAYMENT
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  INCOMPLETE
}

enum AddOnCode {
  ADDITIONAL_AGENT
  CUSTOM_CONSUMER_APP
  GOOGLE_PPC
  META_ADS
}

enum AddOnGrantStatus {
  PENDING_FULFILLMENT
  ACTIVE
  CANCELLED
}

enum EntitlementSource {
  PLAN
  ADDON
  MANUAL_GRANT
  PROMOTION
}

enum ProvisioningRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ProvisioningStepStatus {
  PENDING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum WorkspaceStatusReasonCode {
  BILLING_PAST_DUE
  MANUAL
  CANCELLATION
  REACTIVATION
  PROVISION
  OTHER
}

enum WorkspaceStatusActorType {
  SYSTEM
  PLATFORM_OPERATOR
}

enum PlatformAuditActorType {
  SYSTEM
  OPERATOR
  WEBHOOK
}

enum WorkspaceEmailDomainStatus {
  NONE
  PENDING
  VERIFIED
  FAILED
}

/**
 * Stage 6.10A — owner password activation token lifecycle.
 */
enum WorkspaceOwnerActivationStatus {
  PENDING
  SENT
  USED
  REVOKED
  EXPIRED
}

/**
 * Stage 6.10A — durable onboarding step progress (no workflow engine).
 */
enum WorkspaceOnboardingStepStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
  SKIPPED
}

enum SmsAutomationRecipient {
  LEAD
  AGENT
}

enum SmsAutomationVersionStatus {
  DRAFT
  PUBLISHED
}

enum SmsUsageCategory {
  AUTOMATION
  AGENT_INDIVIDUAL
  AGENT_MASS
  AGENT_NOTIFICATION
}

enum SmsUsageRecipientType {
  LEAD
  AGENT
}

enum SmsSegmentCountSource {
  ESTIMATED
  PROVIDER
}

enum SmsMassBatchStatus {
  PENDING
  RUNNING
  COMPLETE
  BLOCKED
}

enum SmsMassRecipientStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  EXCLUDED
}

enum SmsAutomationDispatchStatus {
  PENDING
  PROCESSING
  SENT
  SKIPPED
  FAILED
}

/**
 * Stage 6.11G.2 — platform directory: what kind of real-estate organization / system.
 * BOARD does not imply ownership of a listing feed.
 */
enum RealEstateOrganizationKind {
  BOARD
  ASSOCIATION
  MLS
  DATA_SYSTEM
  OTHER
}

/**
 * Stage 6.11G.2 — whether HouzzatPRO has an integration path for this org.
 * Does NOT mean any tenant is authorized to display that org's listings.
 */
enum RealEstateOrganizationSupportStatus {
  SUPPORTED
  PLANNED
  UNSUPPORTED
}

/**
 * Stage 6.11G.3 / G.3A — declared vs verified Workspace ↔ organization affiliation.
 * Even VERIFIED grants ZERO listing rights — that requires a future
 * ACTIVE WorkspaceDataConnection + capabilities (not this model).
 * Workspace is the MLS/listing-access boundary (not Team members / Users).
 */
enum WorkspaceReoMembershipStatus {
  DECLARED
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  INACTIVE
}

/**
 * Stage 6.11G.4 — Workspace listing-data connection lifecycle.
 * Only ACTIVE may eventually contribute MLS inventory (fail closed otherwise).
 * Connection ≠ membership ≠ listing entitlement resolver (not built yet).
 */
enum WorkspaceDataConnectionStatus {
  PENDING
  ACTIVE
  FAILED
  SUSPENDED
  REVOKED
  DISCONNECTED
}

/**
 * Stage 6.11G.4 / G.4A — provider-neutral DATA / inventory capabilities.
 * What datasets a connection may provide/use — NOT access/display policy.
 * IDX/VOW and other board-specific access classes belong in provider adapters
 * (and optional future policy persistence), not this universal enum.
 * Presence of a capability row = granted for that dataset. Absence = not authorized.
 * Additive enum: new values require migration; safer than free-form strings for v1.
 */
enum WorkspaceDataConnectionCapabilityKind {
  ACTIVE_LISTINGS
  SOLD
  HISTORY
  OPEN_HOUSES
  MEDIA
}

enum AgentTaskType {
  CALL
  EMAIL
  TODO
}

enum AgentTaskStatus {
  OPEN
  DONE
  CANCELLED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /**
   * Soft seat cap for future billing.
   */
  seatLimit Int      @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrganizationMembership[]
  invites     OrganizationInvite[]
  leads       Lead[]
  tasks       AgentTask[]
  leadNotes   LeadNote[]
  emailLogs   LeadEmailLog[]
}

model OrganizationMembership {
  id             String            @id @default(cuid())
  organizationId String
  userId         String
  role           OrgMembershipRole @default(AGENT)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model OrganizationInvite {
  id             String            @id @default(cuid())
  organizationId String
  email          String
  role           OrgMembershipRole @default(AGENT)
  token          String            @unique @default(cuid())
  invitedById    String?
  acceptedAt     DateTime?
  expiresAt      DateTime
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@index([token])
}

/**
 * Future tenant/security boundary (Stage 1 foundation).
 * Parallel to Organization — no runtime wiring yet.
 */
model Workspace {
  id                    String          @id @default(cuid())
  slug                  String          @unique
  name                  String
  status                WorkspaceStatus @default(ACTIVE)
  /**
   * Subscription purchaser / billing admin (future).
   */
  billingOwnerUserId    String?
  /**
   * Designated business-facing agent (future badge/routing UI — not wired).
   */
  primaryAgentId        String?
  /**
   * Display/compliance metadata only — NOT a tenant isolation key.
   */
  brokerageAffiliation  String?
  /**
   * Stage 6.1 — explicit current Subscription pointer (0/1).
   * Historical subscriptions remain via Subscription.workspaceId (1→many).
   */
  currentSubscriptionId String?         @unique
  /**
   * Dedicated Twilio long code for this workspace (E.164). Unique when set.
   * Inbound tenant routing key (To-number). Never a cross-tenant From.
   */
  twilioPhoneE164             String?         @unique
  /**
   * Twilio subaccount SID (ACxxx) that owns this workspace's Messaging
   * Service and number. Unique when set. Auth tokens are never stored here.
   */
  twilioSubaccountSid         String?         @unique
  /**
   * Twilio Messaging Service SID (MGxxx) in that subaccount. Unique when set.
   */
  twilioMessagingServiceSid   String?         @unique
  /**
   * Twilio Incoming Phone Number SID (PNxxx). Unique when set.
   */
  twilioPhoneSid              String?         @unique
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  billingOwner                      User?                                       @relation("WorkspaceBillingOwner", fields: [billingOwnerUserId], references: [id], onDelete: SetNull)
  primaryAgent                      User?                                       @relation("WorkspacePrimaryAgent", fields: [primaryAgentId], references: [id], onDelete: SetNull)
  currentSubscription               Subscription?                               @relation("WorkspaceCurrentSubscription", fields: [currentSubscriptionId], references: [id], onDelete: SetNull)
  subscriptions                     Subscription[]                              @relation("WorkspaceSubscriptions")
  members                           WorkspaceMember[]
  invites                           WorkspaceInvite[]
  leads                             Lead[]
  agentTasks                        AgentTask[]
  leadNotes                         LeadNote[]
  leadEmailLogs                     LeadEmailLog[]
  crmRoutingSettings                CrmRoutingSettings?
  domains                           WorkspaceDomain[]
  branding                          WorkspaceBranding?
  viewingTours                      ViewingTour[]
  cmaReports                        CmaReport[]
  seatQuota                         WorkspaceSeatQuota?
  entitlements                      WorkspaceEntitlement[]
  addOnGrants                       AddOnGrant[]
  emailIdentity                     WorkspaceEmailIdentity?
  statusEvents                      WorkspaceStatusEvent[]
  billingCustomer                   BillingCustomer?
  commercialOffers                  CommercialOffer[]
  provisioningRuns                  ProvisioningRun[]
  ownerActivations                  WorkspaceOwnerActivation[]
  onboardingState                   WorkspaceOnboardingState?
  /**
   * Stage 6.11D — canonical professional + brokerage website identity.
   */
  professionalIdentity              WorkspaceProfessionalIdentity?
  /**
   * Stage 6.11E.3A — TEAM public profile (about / service areas / leader pointer).
   */
  teamProfile                       WorkspaceTeamProfile?
  /**
   * Stage 6.11E.3A — TEAM public roster (independent of User / seats).
   */
  teamMembers                       WorkspaceTeamMember[]
  /**
   * Stage 6.11G.3 — declared/verified org membership(s). NOT listing entitlement.
   */
  realEstateOrganizationMemberships WorkspaceRealEstateOrganizationMembership[]
  /**
   * Stage 6.11G.4 — authorized listing-data connection(s). NOT membership.
   * Only ACTIVE + capabilities eventually feed entitlement (resolver not built).
   */
  dataConnections                   WorkspaceDataConnection[]
  workspaceTags                     WorkspaceTag[]
  leadTags                          LeadTag[]
  leadOrigins                       LeadOrigin[]
  leadImportJobs                    LeadImportJob[]
  leadImportRows                    LeadImportRow[]
  conversations                     Conversation[]
  smsSuppressions                   SmsSuppression[]
  inboundSmsQuarantines             InboundSmsQuarantine[]
  outboundSmsDeadLetters            OutboundSmsDeadLetter[]
  smsUsageEvents                    SmsUsageEvent[]
  smsMassBatches                    SmsMassBatch[]
  smsAutomationDispatches           SmsAutomationDispatch[]

  @@index([status])
}

/**
 * Stage 6.11D — workspace-scoped professional + brokerage identity (tenant data).
 * Image assets stay on WorkspaceBranding (agentProfilePhotoUrl / brokerageLogoUrl).
 * Not template-specific; all website templates consume via shared resolver.
 */
model WorkspaceProfessionalIdentity {
  workspaceId             String   @id
  /**
   * Licensed / registered agent display name for public website identity.
   */
  agentRegisteredName     String?
  /**
   * Permitted designation (e.g. Salesperson, Broker, Broker of Record).
   */
  agentDesignation        String?
  /**
   * Agent cell / mobile — not WorkspaceBranding.contactPhone.
   */
  agentCellPhone          String?
  /**
   * Registered brokerage legal/trade name — not WorkspaceBranding.displayName.
   */
  brokerageRegisteredName String?
  brokeragePhone          String?
  brokerageFax            String?
  brokerageAddress        String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/**
 * Stage 6.11E.3A / 6.11E.3A.2 — workspace-scoped TEAM public profile (tenant brand data).
 * Does NOT duplicate Team Name / Logo / Phone / Email / Tagline — those stay on
 * WorkspaceBranding. Brokerage stays on WorkspaceProfessionalIdentity + branding logos.
 * Leader authority is leaderMemberId only (no isLeader on members).
 * Composite FK (workspaceId, leaderMemberId) enforces same-workspace leader;
 * ON DELETE Restrict — app must clear leader before deleting that member.
 */
model WorkspaceTeamProfile {
  workspaceId    String   @id
  aboutText      String?
  /**
   * Runtime: string[]. Validated in app layer — not a normalized table.
   */
  serviceAreas   Json?
  /**
   * Single Team Leader pointer. Cleared by app before leader member delete/hide.
   * DB Restrict fails closed if clear is skipped.
   */
  leaderMemberId String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leaderMember WorkspaceTeamMember? @relation("WorkspaceTeamLeader", fields: [workspaceId, leaderMemberId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, leaderMemberId])
}

/**
 * Stage 6.11E.3A / 6.11E.3A.2 — public Team roster member (presentation data only).
 * Not a User / WorkspaceMember / paid seat. No account linkage in this stage.
 * name / designation / photoUrl nullable for draft editing; public publication
 * and TEAM completion rules require all three when isVisible=true.
 */
model WorkspaceTeamMember {
  id          String   @id @default(cuid())
  workspaceId String
  name        String?
  designation String?
  photoUrl    String?
  cellPhone   String?
  email       String?
  bio         String?
  sortOrder   Int      @default(0)
  /**
   * Defaults false so incomplete drafts are not public until OWNER shows them.
   */
  isVisible   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace          Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leadingTeamProfile WorkspaceTeamProfile? @relation("WorkspaceTeamLeader")

  @@unique([workspaceId, id])
  @@index([workspaceId, sortOrder])
  @@index([workspaceId, isVisible])
}

/**
 * Stage 3K.2 — trusted hostname → workspace mapping.
 * Constraints (partial unique indexes in migration SQL):
 * - one PLATFORM hostname per workspace
 * - one CUSTOM PRIMARY per workspace
 * - hostname globally unique
 */
model WorkspaceDomain {
  id                String                @id @default(cuid())
  workspaceId       String
  hostname          String                @unique
  kind              WorkspaceDomainKind   @default(CUSTOM)
  role              WorkspaceDomainRole
  status            WorkspaceDomainStatus @default(PENDING)
  verificationToken String?
  verifiedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, kind])
}

/**
 * Stage 3K.2 — per-workspace public/staff branding configuration.
 */
model WorkspaceBranding {
  workspaceId          String       @id
  tier                 BrandingTier @default(SEMI_BRANDED)
  displayName          String
  tagline              String?
  logoUrl              String?
  brokerageLogoUrl     String?
  faviconUrl           String?
  /**
   * Stage 6.11C.1 — workspace website portrait (Agent templates); not User.image.
   */
  agentProfilePhotoUrl String?
  primaryColor         String?
  secondaryColor       String?
  accentColor          String?
  /**
   * Stage 6.1 — code-catalog ThemeId (theme definitions are not DB rows).
   */
  themeId              String?
  contactEmail         String?
  contactPhone         String?
  footerLegalText      String?
  /**
   * @deprecated Product invariant — resolver always forces true; tenants cannot disable.
   */
  poweredByHouzzatPro  Boolean      @default(true)
  seoDescription       String?
  ogImageUrl           String?
  version              Int          @default(1)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceMember {
  id          String                @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceMemberRole   @default(AGENT)
  status      WorkspaceMemberStatus @default(ACTIVE)
  invitedById String?
  joinedAt    DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceMemberInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, status])
}

model WorkspaceInvite {
  id          String                @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceMemberRole   @default(AGENT)
  token       String                @unique @default(cuid())
  invitedById String?
  status      WorkspaceInviteStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  /**
   * Admin-managed professional snapshot captured at invite time.
   * Applied to User + AgentProfile on provision / accept. Not a second profile.
   */
  firstName              String?
  lastName               String?
  phone                  String?
  recoLicenseNumber      String?
  recoLicenseExpiresAt   DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceInviteInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, email])
  @@index([workspaceId, status])
  @@index([token])
}

model User {
  id                     String              @id @default(cuid())
  name                   String?
  email                  String              @unique
  emailVerified          DateTime?
  password               String?
  image                  String?
  role                   Role                @default(BUYER)
  /**
   * Consumer can use buyer dashboard / buyer search prefs.
   */
  isBuyer                Boolean             @default(true)
  /**
   * Consumer can use seller dashboard (/owner) / seller search prefs.
   */
  isSeller               Boolean             @default(false)
  /**
   * Buy/sell horizon — set by customer popup or agent in CRM.
   */
  purchaseTimeframe      PurchaseTimeframe?
  /**
   * Which consumer dashboard + search context is active.
   */
  activeMode             ActiveMode          @default(BUYER)
  phone                  String?
  /**
   * Normalized E.164 from `phone` when parseable. Indexed, not unique —
   * the same number may exist on more than one User across workspaces.
   */
  phoneE164              String?
  /**
   * Agent-confirmed phone on CRM lead desk (not SMS OTP).
   */
  phoneVerifiedAt        DateTime?
  /**
   * Agent requested customer to update email on next visit.
   */
  emailUpdateRequestedAt DateTime?
  /**
   * Agent requested customer to update phone on next visit.
   */
  phoneUpdateRequestedAt DateTime?
  /**
   * Client home / location address — used as Route Planner start + admin CRM.
   */
  homeAddress            String?
  homeLat                Float?
  homeLng                Float?
  caslConsentAt          DateTime?
  vowAcceptedAt          DateTime?
  vowVersion             String?
  termsAcceptedAt        DateTime?
  termsVersion           String?
  emailAlertsEnabled     Boolean             @default(true)
  smsAlertsEnabled       Boolean             @default(false)
  relatedListingsMode    RelatedListingsMode @default(SAME_AREA)
  /**
   * Last successful daily Saved Search Digest send.
   */
  lastBuyerDigestAt      DateTime?
  /**
   * Last successful Neighborhood Weekly Report send.
   */
  lastSellerReportAt     DateTime?
  /**
   * Per-type push toggles (+ nested staffEmail category prefs for HouzzatPro).
   * Missing push key = on. Missing staffEmail category = on.
   * Keys: src/lib/notifications/catalog.ts + staff-categories.ts
   */
  pushNotificationPrefs  Json?
  /**
   * Soft-suspend: blocked from signing in / using the product.
   */
  disabledAt             DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  accounts                  Account[]
  sessions                  Session[]
  agentProfile              AgentProfile?
  siteVisitors              SiteVisitor[]
  activityEvents            ActivityEvent[]
  auditLogs                 AuditLog[]                 @relation("AuditActor")
  orgMemberships            OrganizationMembership[]
  leads                     Lead[]                     @relation("CustomerLeads")
  assignedLeads             Lead[]                     @relation("AssignedLeads")
  activities                LeadActivity[]
  appointments              Appointment[]              @relation("CustomerAppointments")
  agentAppointments         Appointment[]              @relation("AgentAppointments")
  landingPages              LandingPage[]
  consentEvents             ConsentEvent[]
  savedListings             SavedListing[]
  savedSearches             SavedSearch[]
  listingViews              ListingView[]
  listingNotes              ListingNote[]
  propertyMonitors          PropertyMonitor[]
  areaMonitors              AreaMonitor[]
  customerAlerts            CustomerAlert[]
  adCampaigns               AdCampaign[]
  cmaReports                CmaReport[]
  referralHandoffs          ReferralHandoff[]          @relation("AgentHandoffs")
  ownedListings             Listing[]                  @relation("OwnerListings")
  ownerOrders               OwnerListingOrder[]        @relation("OwnerOrders")
  reviewedOwnerListings     Listing[]                  @relation("OwnerListingReviewer")
  waivedOwnerOrders         OwnerListingOrder[]        @relation("OwnerOrderAdmin")
  ownerConsents             OwnerListingConsent[]
  viewingTours              ViewingTour[]              @relation("CustomerViewingTours")
  agentViewingTours         ViewingTour[]              @relation("AgentViewingTours")
  assignedTasks             AgentTask[]                @relation("TaskAssignee")
  createdTasks              AgentTask[]                @relation("TaskCreator")
  leadNotesAuthored         LeadNote[]                 @relation("LeadNoteAuthor")
  leadEmailsSent            LeadEmailLog[]             @relation("LeadEmailSender")
  listingAgentFor           CrmRoutingSettings[]       @relation("ListingAgentSettings")
  routingWeights            CrmRoutingWeight[]
  pushDevices               PushDevice[]
  workspaceMemberships      WorkspaceMember[]
  workspaceMembersInvited   WorkspaceMember[]          @relation("WorkspaceMemberInvitedBy")
  workspaceInvitesSent      WorkspaceInvite[]          @relation("WorkspaceInviteInvitedBy")
  workspacesBillingOwned    Workspace[]                @relation("WorkspaceBillingOwner")
  workspacesPrimaryAgentFor Workspace[]                @relation("WorkspacePrimaryAgent")
  /**
   * Stage 6.1 — SaaS control-plane operator identity (NOT CRM / WorkspaceMember).
   */
  platformOperator          PlatformOperator?
  ownerActivations          WorkspaceOwnerActivation[]
  leadImportJobs            LeadImportJob[]            @relation("LeadImportImportedBy")
  conversationAgentReads    Conversation[]             @relation("ConversationAgentLastReadBy")
  messagesSent              Message[]                  @relation("MessageSender")
  messagesCreated           Message[]                  @relation("MessageCreatedBy")
  messagesDeleted           Message[]                  @relation("MessageDeletedBy")
  messageRevisions          MessageRevision[]          @relation("MessageRevisionActor")
  messageReactions          MessageReaction[]

  @@index([phoneE164])
}

/**
 * FCM/APNs token for Houzzat or HouzzatPro native shells.
 */
model PushDevice {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  shell     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, shell])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AgentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  bio       String?  @db.Text
  markets   String[] @default([])
  /**
   * Display cellphone. Canonical SMS destination remains User.phoneE164.
   * Kept in lockstep with User.phone by Admin-managed profile writes.
   */
  phone     String?
  firstName String?
  lastName  String?
  recoLicenseNumber    String?
  recoLicenseExpiresAt DateTime?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Lead {
  id               String      @id @default(cuid())
  status           LeadStatus  @default(NEW_LEAD)
  source           LeadSource  @default(OTHER)
  /**
   * Buyer desk vs seller desk (buyer+seller treated as SELLER).
   */
  intent           LeadIntent  @default(BUYER)
  score            Int         @default(0)
  notes            String?     @db.Text
  listingMls       String?
  customerId       String?
  assignedAgentId  String?
  /**
   * Tenant boundary for team / solo agent CRM.
   */
  organizationId   String?
  /**
   * Future workspace tenant key (Stage 3B — nullable until backfill).
   */
  workspaceId      String?
  landingPageId    String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmContent       String?
  adCampaignId     String?
  /**
   * CASL-style consent to be contacted by a Houzzat agent about this request.
   */
  contactConsentAt DateTime?
  /**
   * When agent first moved pipeline NEW_LEAD → ATTEMPTED_CONTACT (response SLA).
   */
  firstRespondedAt DateTime?
  /**
   * When pipeline status last changed (banner date).
   */
  statusChangedAt  DateTime    @default(now())
  /**
   * Agent-set inquiry classification (Viewing / Home Value / etc.).
   */
  inquiryTag       InquiryTag?
  lostReason       String?
  winReason        String?
  /**
   * Workspace-scoped CRM classification (HouzzatPRO).
   * NULL = not backfilled yet — do not treat NULL as Buyer/Seller.
   * User.isBuyer / User.isSeller remain Houzzat consumer/account flags.
   * Buyer+Seller = both true; Lead.intent stays SELLER. No LeadIntent.BOTH.
   */
  isBuyer          Boolean?
  isSeller         Boolean?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  customer      User?           @relation("CustomerLeads", fields: [customerId], references: [id], onDelete: SetNull)
  assignedAgent User?           @relation("AssignedLeads", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  organization  Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  workspace     Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  landingPage   LandingPage?    @relation(fields: [landingPageId], references: [id], onDelete: SetNull)
  adCampaign    AdCampaign?     @relation(fields: [adCampaignId], references: [id], onDelete: SetNull)
  activities    LeadActivity[]
  appointments  Appointment[]
  viewingTours  ViewingTour[]
  tasks         AgentTask[]
  leadNotes     LeadNote[]
  emailLogs     LeadEmailLog[]
  cmaReports    CmaReport[]
  tags          LeadTag[]
  origin        LeadOrigin?
  importRows    LeadImportRow[]
  conversation  Conversation?

  @@unique([workspaceId, id])
  @@index([status, assignedAgentId])
  @@index([organizationId, status])
  @@index([organizationId, assignedAgentId])
  @@index([workspaceId, status])
  @@index([workspaceId, assignedAgentId])
  @@index([source])
  @@index([intent, status])
  @@index([utmCampaign])
  @@index([adCampaignId])
}

/**
 * Workspace-scoped tag catalog. Buyer/Seller/Both are generated from Lead flags,
 * not catalog rows. Imported CRM text such as "Seller" may still be an IMPORTED tag.
 */
model WorkspaceTag {
  id             String             @id @default(cuid())
  workspaceId    String
  name           String
  nameNormalized String
  origin         WorkspaceTagOrigin @default(MANUAL)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leadTags  LeadTag[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, nameNormalized])
  @@index([workspaceId])
}

model LeadTag {
  id          String   @id @default(cuid())
  workspaceId String
  leadId      String
  tagId       String
  createdAt   DateTime @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead         @relation(fields: [workspaceId, leadId], references: [workspaceId, id], onDelete: Cascade)
  tag       WorkspaceTag @relation(fields: [workspaceId, tagId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, leadId, tagId])
  @@index([workspaceId, tagId])
  @@index([leadId])
}

/**
 * Durable original-CRM archaeology. Does not overload Lead.createdAt, Lead.source, or notes.
 */
model LeadOrigin {
  id                     String    @id @default(cuid())
  workspaceId            String
  leadId                 String    @unique
  sourceCrm              String?
  externalContactId      String?
  originalClassification String?
  sourceCreatedAt        DateTime?
  sourceClosedAt         DateTime?
  unmappedFields         Json?
  importRowId            String?   @unique
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead           @relation(fields: [workspaceId, leadId], references: [workspaceId, id], onDelete: Cascade)
  importRow LeadImportRow? @relation(fields: [importRowId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, leadId])
  @@index([workspaceId, sourceCrm])
  @@index([workspaceId, sourceCrm, externalContactId])
}

model LeadImportJob {
  id                 String                @id @default(cuid())
  workspaceId        String
  importedByUserId   String
  filename           String?
  sourceCrm          String?
  mapping            Json
  defaultLeadType    LeadImportDefaultType
  consentAsserted    Boolean               @default(false)
  checksum           String?
  allowDuplicates    Boolean               @default(false)
  policies           Json?
  status             LeadImportJobStatus   @default(PENDING)
  createdCount       Int                   @default(0)
  skippedCount       Int                   @default(0)
  failedCount        Int                   @default(0)
  deferredFieldCount Int                   @default(0)
  error              String?
  startedAt          DateTime?
  finishedAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  importedBy User            @relation("LeadImportImportedBy", fields: [importedByUserId], references: [id], onDelete: Restrict)
  rows       LeadImportRow[]

  @@unique([workspaceId, id])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
  @@index([workspaceId, checksum])
}

model LeadImportRow {
  id               String              @id @default(cuid())
  workspaceId      String
  jobId            String
  rowNumber        Int
  payloadOriginal  Json
  payloadCanonical Json
  status           LeadImportRowStatus @default(PENDING)
  leadId           String?
  error            String?
  idempotencyKey   String?
  attemptCount     Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  job       LeadImportJob @relation(fields: [workspaceId, jobId], references: [workspaceId, id], onDelete: Cascade)
  /**
   * Simple FK for Prisma (leadId optional). Tenant-safe composite FK is in migration SQL
   * (MATCH SIMPLE: NULL leadId skips the check).
   */
  lead      Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  origin    LeadOrigin?

  @@unique([workspaceId, id])
  @@unique([jobId, rowNumber])
  @@unique([jobId, idempotencyKey])
  @@index([workspaceId, status])
  @@index([leadId])
}

/**
 * CRM routing config — legacy singleton (id = "default") or per-workspace row.
 */
model CrmRoutingSettings {
  id               String               @id @default("default")
  /**
   * Future per-workspace routing (Stage 3H — nullable until backfill).
   */
  workspaceId      String?              @unique
  listingAgentId   String?
  sellerAssignMode SellerLeadAssignMode @default(LISTING_AGENT)
  updatedAt        DateTime             @updatedAt

  workspace    Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  listingAgent User?              @relation("ListingAgentSettings", fields: [listingAgentId], references: [id], onDelete: SetNull)
  weights      CrmRoutingWeight[]

  @@index([workspaceId])
}

model CrmRoutingWeight {
  id            String          @id @default(cuid())
  settingsId    String          @default("default")
  agentId       String
  lane          LeadRoutingLane
  percent       Int             @default(0)
  /**
   * Deficit round-robin counter for fair weighted assignment.
   */
  assignedCount Int             @default(0)

  settings CrmRoutingSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  agent    User               @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([settingsId, agentId, lane])
  @@index([settingsId, lane])
}

model AgentTask {
  id             String          @id @default(cuid())
  organizationId String
  /**
   * Future workspace tenant key (Stage 3B — nullable until backfill).
   */
  workspaceId    String?
  leadId         String?
  assigneeId     String
  createdById    String?
  type           AgentTaskType   @default(TODO)
  status         AgentTaskStatus @default(OPEN)
  title          String
  body           String?         @db.Text
  dueAt          DateTime
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignee     User         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([assigneeId, status, dueAt])
  @@index([organizationId, status, dueAt])
  @@index([workspaceId, status, dueAt])
  @@index([leadId, status])
}

model LeadNote {
  id             String           @id @default(cuid())
  organizationId String
  /**
   * Future workspace tenant key (Stage 3B — nullable until backfill).
   */
  workspaceId    String?
  leadId         String
  authorId       String
  body           String           @db.Text
  category       LeadNoteCategory @default(GENERAL)
  pinned         Boolean          @default(false)
  pinnedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author       User         @relation("LeadNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([leadId, pinned, pinnedAt])
  @@index([organizationId, createdAt])
  @@index([workspaceId, createdAt])
}

model LeadEmailLog {
  id             String    @id @default(cuid())
  organizationId String
  /**
   * Future workspace tenant key (Stage 3B — nullable until backfill).
   */
  workspaceId    String?
  leadId         String
  /**
   * Null for automated system emails (alerts, welcome, etc.).
   */
  sentById       String?
  toEmail        String
  subject        String
  /**
   * Plain-text body (and short CRM snippet).
   */
  body           String    @db.Text
  /**
   * Full HTML for Preview Email in CRM.
   */
  htmlBody       String?   @db.Text
  /**
   * Template key: price_reduction, just_listed, shortlist, custom, …
   */
  kind           String    @default("custom")
  mlsNumber      String?
  /**
   * Resend email id — used to match open/click webhooks.
   */
  providerId     String?   @unique
  openedAt       DateTime?
  openCount      Int       @default(0)
  clickedAt      DateTime?
  clickCount     Int       @default(0)
  lastClickedUrl String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sentBy       User?        @relation("LeadEmailSender", fields: [sentById], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([organizationId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([kind, createdAt])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  userId    String?
  type      String
  body      String?  @db.Text
  meta      Json?
  createdAt DateTime @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

/**
 * Permanent HouzzatPRO Agent ↔ Lead thread.
 * ONE workspace + ONE lead = ONE conversation. Not owned by an agent;
 * operational owner is always Lead.assignedAgentId.
 */
model Conversation {
  id                    String             @id @default(cuid())
  workspaceId           String
  leadId                String
  status                ConversationStatus @default(OPEN)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  lastMessageAt         DateTime?
  customerLastReadAt    DateTime?
  agentLastReadAt       DateTime?
  /**
   * User who last opened/read as assignee. Unread cursor is valid only when this
   * equals Lead.assignedAgentId. Do not set on reassignment — set on agent read.
   */
  agentLastReadByUserId String?

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead            Lead      @relation(fields: [workspaceId, leadId], references: [workspaceId, id], onDelete: Cascade)
  agentLastReadBy User?     @relation("ConversationAgentLastReadBy", fields: [agentLastReadByUserId], references: [id], onDelete: SetNull)
  messages        Message[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, leadId])
  @@index([workspaceId, lastMessageAt])
  @@index([leadId])
  @@index([agentLastReadByUserId])
}

/**
 * Chat + SMS transcript. Authoritative lead path is Message → Conversation → Lead.
 * leadId is denormalized for scoped queries / future merge; it is not a Lead FK.
 */
model Message {
  id               String            @id @default(cuid())
  workspaceId      String
  conversationId   String
  leadId           String
  channel          MessageChannel
  kind             MessageKind       @default(TEXT)
  senderKind       MessageSenderKind
  senderUserId     String?
  senderName       String
  createdByUserId  String?
  body             String?           @db.Text
  editedAt         DateTime?
  deletedAt        DateTime?
  deletedByUserId  String?
  replyToMessageId String?
  createdAt        DateTime          @default(now())
  deliveredAt      DateTime?
  smsSource        MessageSmsSource?
  twilioMessageSid String?           @unique
  providerStatus   String?
  smsFrom          String?
  smsTo            String?
  payload          Json?

  conversation Conversation        @relation(fields: [workspaceId, conversationId], references: [workspaceId, id], onDelete: Cascade)
  senderUser   User?               @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  createdBy    User?               @relation("MessageCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  deletedBy    User?               @relation("MessageDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  replyTo      Message?            @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies      Message[]           @relation("MessageReplies")
  revisions    MessageRevision[]
  attachments  MessageAttachment[]
  reactions    MessageReaction[]

  @@unique([workspaceId, id])
  @@index([workspaceId, conversationId, createdAt])
  @@index([workspaceId, leadId, createdAt])
  @@index([conversationId, createdAt])
  @@index([senderUserId])
  @@index([createdByUserId])
  @@index([deletedByUserId])
  @@index([replyToMessageId])
}

/**
 * Per-workspace SMS STOP suppression. Same phone may be suppressed in one
 * tenant and still reachable in another (different Twilio To-number).
 */
model SmsSuppression {
  id           String   @id @default(cuid())
  workspaceId  String
  phoneE164    String
  suppressedAt DateTime @default(now())
  keyword      String?
  source       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, phoneE164])
  @@index([phoneE164])
}

/**
 * Inbound SMS that could not be attached to an existing Lead/Conversation.
 * Never creates CRM rows. Body is not stored.
 */
model InboundSmsQuarantine {
  id               String   @id @default(cuid())
  twilioMessageSid String   @unique
  fromE164         String
  toE164           String
  reason           String
  workspaceId      String?
  receivedAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId, receivedAt])
  @@index([fromE164])
}

/**
 * Twilio accepted an outbound SMS but Conversation Message persist failed.
 * Unique MessageSid lets an operator reconcile without sending twice.
 * Body is not stored.
 */
model OutboundSmsDeadLetter {
  id               String   @id @default(cuid())
  twilioMessageSid String   @unique
  workspaceId      String
  leadId           String
  conversationId   String?
  fromE164         String
  toE164           String
  reason           String
  createdAt        DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([leadId])
}

/**
 * Hidden edit/delete audit. Do not create a row on initial send.
 */
model MessageRevision {
  id          String                @id @default(cuid())
  workspaceId String
  messageId   String
  action      MessageRevisionAction
  body        String?               @db.Text
  actorUserId String?
  createdAt   DateTime              @default(now())

  message Message @relation(fields: [workspaceId, messageId], references: [workspaceId, id], onDelete: Cascade)
  actor   User?   @relation("MessageRevisionActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, messageId, createdAt])
  @@index([actorUserId])
}

/**
 * Future IMAGE / VOICE_NOTE metadata. Storage is not implemented here.
 */
model MessageAttachment {
  id          String                @id @default(cuid())
  workspaceId String
  messageId   String
  kind        MessageAttachmentKind
  objectKey   String
  mimeType    String
  byteSize    Int
  width       Int?
  height      Int?
  durationMs  Int?
  sortOrder   Int                   @default(0)
  revokedAt   DateTime?
  createdAt   DateTime              @default(now())

  message Message @relation(fields: [workspaceId, messageId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, messageId, sortOrder])
}

model MessageReaction {
  id          String   @id @default(cuid())
  workspaceId String
  messageId   String
  userId      String
  key         String
  createdAt   DateTime @default(now())

  message Message @relation(fields: [workspaceId, messageId], references: [workspaceId, id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([workspaceId, messageId])
}

model Appointment {
  id           String            @id @default(cuid())
  type         AppointmentType
  status       AppointmentStatus @default(REQUESTED)
  startsAt     DateTime?
  endsAt       DateTime?
  listingMls   String?
  notes        String?           @db.Text
  focusNotes   String?           @db.Text
  videoJoinUrl String?
  customerId   String?
  agentId      String?
  leadId       String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  customer        User?            @relation("CustomerAppointments", fields: [customerId], references: [id], onDelete: SetNull)
  agent           User?            @relation("AgentAppointments", fields: [agentId], references: [id], onDelete: SetNull)
  lead            Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  viewingTourStop ViewingTourStop?

  @@index([status, startsAt])
  @@index([agentId, status])
}

model LandingPage {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  headline     String?
  subtitle     String?  @db.Text
  ctaLabel     String?  @default("Get started")
  ctaHref      String?  @default("/home-valuation")
  heroImageUrl String?
  areaFocus    String?
  utmCampaign  String?
  content      Json?
  published    Boolean  @default(false)
  ownerAgentId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownerAgent User?  @relation(fields: [ownerAgentId], references: [id], onDelete: SetNull)
  leads      Lead[]
}

model ConsentEvent {
  id        String   @id @default(cuid())
  userId    String?
  leadId    String?
  email     String?
  kind      String
  version   String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

