/**
 * Stage 6.11G.2 — platform catalog of real-estate organizations / MLS systems
 * (Canada boards/associations + U.S. associations/MLS/data systems).
 * NOT tenant entitlement. NOT listing inventory. NOT credentials.
 * Distinct from legacy CRM `Organization`.
 * Referenced by WorkspaceRealEstateOrganizationMembership (G.3) and
 * WorkspaceDataConnection (G.4) — membership ≠ data connection ≠ listing rights.
 * Future provider integrations stay in separate models (not columns here).
 * Future org↔org links (association uses MLS X) via join table — no parentId yet.
 */
model RealEstateOrganization {
  id            String                              @id @default(cuid())
  name          String
  /**
   * URL-safe unique catalog key, e.g. ca-on-trreb
   */
  slug          String                              @unique
  /**
   * Common short label (e.g. TRREB) when useful for search/display.
   */
  shortName     String?
  /**
   * ISO 3166-1 alpha-2 (CA | US for v1).
   */
  countryCode   String
  /**
   * Subdivision code without country prefix (e.g. ON, NY, DC).
   * Null when organization is national / multi-region.
   */
  regionCode    String?
  kind          RealEstateOrganizationKind
  supportStatus RealEstateOrganizationSupportStatus @default(UNSUPPORTED)
  officialUrl   String?
  active        Boolean                             @default(true)
  createdAt     DateTime                            @default(now())
  updatedAt     DateTime                            @updatedAt

  workspaceMemberships WorkspaceRealEstateOrganizationMembership[]
  dataConnections      WorkspaceDataConnection[]
  /**
   * Stage 6.11G.5 — primary listing provenance pointer (nullable until attributed).
   */
  listings             Listing[]
  listingSources       ListingSource[]

  @@index([countryCode, regionCode, active])
  @@index([countryCode, kind, active])
  @@index([supportStatus, active])
  @@index([countryCode, name])
  @@index([shortName])
}

/**
 * Stage 6.11G.3 / G.3A — Workspace ↔ RealEstateOrganization membership.
 * "This Workspace is affiliated with / has selected this organization."
 * MLS/listing access boundary is the Workspace (multi-board allowed).
 * DOES NOT grant listing inventory, MLS credentials, or data-connection rights.
 * Independent of WorkspaceTeamMember (public roster) and WorkspaceMember (SaaS seats).
 * Team members do NOT require individual MLS membership rows.
 * Future WorkspaceDataConnection(s) are siblings on Workspace — independently
 * revocable; multiple ACTIVE connections may UNION into one listing universe.
 * Enum prefix "Reo" = RealEstateOrganization (identifier length); model name is full.
 */
model WorkspaceRealEstateOrganizationMembership {
  id                   String                       @id @default(cuid())
  workspaceId          String
  organizationId       String
  /**
   * Optional provider-neutral board/member/subscriber id metadata.
   * Not credentials, authorization, feed connection, or listing entitlement.
   */
  membershipIdentifier String?
  status               WorkspaceReoMembershipStatus @default(DECLARED)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  workspace    Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization RealEstateOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  /**
   * One membership row per workspace + organization (e.g. TRREB and LSTAR
   * are two rows on the same Workspace).
   */
  @@unique([workspaceId, organizationId])
  @@index([workspaceId, status])
  @@index([organizationId, status])
}

/**
 * Stage 6.11G.4 — Workspace authorized listing-data connection.
 * AUTHORIZATION / integration config — not duplicate per-tenant listing ingestion.
 * Membership ≠ this model. Even VERIFIED membership grants ZERO listing rights
 * without an eligible ACTIVE connection + capabilities.
 * Organization and provider are first-class and distinct (e.g. TRREB + proptx).
 * No FK to membership — service layer requires matching membership; lifecycles
 * remain independently revocable.
 * No User / WorkspaceMember / WorkspaceTeamMember ownership FKs.
 * Secrets: credentialRef only (opaque). Never apiKey/password/bearer/token columns.
 * Shared warehouse compatible: connection authorizes provenance/use, not row ownership.
 * Houzzat grandfathering later = explicit membership + connection (no implicit platform feed).
 */
model WorkspaceDataConnection {
  id                           String                        @id @default(cuid())
  workspaceId                  String
  organizationId               String
  /**
   * Platform integration key (e.g. proptx). Not the board/MLS organization.
   * Stable lowercase identifier — not a free-form display name.
   */
  providerKey                  String
  status                       WorkspaceDataConnectionStatus @default(PENDING)
  /**
   * Opaque reference into future secure secret storage.
   * NEVER a raw API key, bearer token, password, or client secret.
   */
  credentialRef                String?
  /**
   * Safe non-secret external account/subscriber/connection id at the provider.
   */
  externalConnectionIdentifier String?
  lastVerifiedAt               DateTime?
  /**
   * Last successful authorized access or sync check (not every connection
   * runs its own listing warehouse ingestion).
   */
  lastSuccessfulAccessAt       DateTime?
  /**
   * Short machine-readable failure code only — never raw provider payloads/secrets.
   */
  lastErrorCode                String?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt

  workspace    Workspace                           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization RealEstateOrganization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  capabilities WorkspaceDataConnectionCapability[]

  /**
   * One connection per workspace + organization + provider integration
   * (TRREB/proptx and LSTAR/othervendor are distinct; same board may later
   * add a second provider without redesign).
   */
  @@unique([workspaceId, organizationId, providerKey])
  @@index([workspaceId, status])
  @@index([organizationId, status])
  @@index([providerKey, status])
}

/**
 * Stage 6.11G.4 — granted capability on a WorkspaceDataConnection.
 * Row presence = authorized for that capability. Delete to revoke.
 */
model WorkspaceDataConnectionCapability {
  id           String                                @id @default(cuid())
  connectionId String
  capability   WorkspaceDataConnectionCapabilityKind
  createdAt    DateTime                              @default(now())

  connection WorkspaceDataConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, capability])
  @@index([capability])
}

