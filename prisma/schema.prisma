model Listing {
  id                       String                 @id @default(cuid())
  mlsNumber                String                 @unique
  /**
   * PropTx / RESO ListingKey — used to join Media / History / OpenHouse.
   * For current PropTx MLS rows this is also the provider-native listing key
   * until composite identity replaces global mlsNumber uniqueness (later stage).
   */
  listingKey               String?                @unique
  status                   ListingStatus          @default(ACTIVE)
  segment                  ListingSegment         @default(RESIDENTIAL)
  transactionType          ListingTransactionType @default(SALE)
  /**
   * Inventory channel: mls | fsbo | mock | manual — NOT board/organization identity.
   */
  dataSource               String                 @default("mock")
  propertyType             PropertyType           @default(DETACHED)
  listPrice                Int
  soldPrice                Int?
  beds                     Float
  baths                    Float
  sqft                     Int?
  parkingSpaces            Int                    @default(0)
  yearBuilt                Int?
  taxes                    Int?
  maintenanceFee           Int?
  addressLine              String
  unitNumber               String?
  city                     String
  community                String?
  postalCode               String?
  province                 String                 @default("ON")
  lat                      Float
  lng                      Float
  description              String                 @db.Text
  brokerageName            String
  /**
   * PropTx / RESO extended fact sheet (lot, basement, heat, garage, features, etc.).
   * Shape: ListingFacts in src/lib/listings/facts.ts
   */
  facts                    Json?
  /**
   * PropTx VOW / RESO: ListingContractDate
   */
  listedAt                 DateTime
  soldAt                   DateTime?
  /**
   * PropTx VOW / RESO: ModificationTimestamp
   */
  updatedAtMls             DateTime
  daysOnMarket             Int                    @default(0)
  /**
   * Last successful PropTx address-history enrich (sibling MLS cycles).
   * Used to skip repeat pulls within TTL.
   */
  addressHistoryEnrichedAt DateTime?
  isMock                   Boolean                @default(true)
  /**
   * Stage 6.11G.5 / G.5A — DENORMALIZED primary provenance for hot filters.
   * Canonical lineage is ListingSource (isPrimary=true). When a primary source
   * exists, these must match that row's organizationId / providerKey.
   * NOT a Workspace FK. NOT WorkspaceDataConnection ownership.
   * FSBO/mock/manual stay null (no MLS ListingSource).
   */
  organizationId           String?
  /**
   * Stage 6.11G.5 / G.5A — DENORMALIZED primary providerKey (see organizationId).
   */
  providerKey              String?
  ownerUserId              String?
  ownerStatus              OwnerListingStatus?
  listedUntil              DateTime?
  ownerReviewedAt          DateTime?
  ownerReviewedById        String?
  ownerReviewNote          String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  owner         User?                   @relation("OwnerListings", fields: [ownerUserId], references: [id], onDelete: SetNull)
  reviewedBy    User?                   @relation("OwnerListingReviewer", fields: [ownerReviewedById], references: [id], onDelete: SetNull)
  organization  RealEstateOrganization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  sources       ListingSource[]
  media         ListingMedia[]
  openHouses    OpenHouse[]
  history       ListingHistory[]
  rooms         ListingRoom[]
  titleParties  OwnerTitleParty[]
  ownerOrders   OwnerListingOrder[]
  ownerConsents OwnerListingConsent[]

  @@index([status, city, listPrice])
  @@index([status, community, listPrice])
  @@index([segment, status, city])
  @@index([transactionType, segment, status, city])
  @@index([dataSource, ownerStatus, status])
  @@index([ownerUserId])
  @@index([lat, lng])
  @@index([listedAt])
  @@index([addressLine])
  @@index([updatedAtMls])
  @@index([organizationId, status])
  @@index([organizationId, mlsNumber])
  @@index([providerKey, listingKey])
}

/**
 * Stage 6.11G.5 / G.5A — listing source lineage (supports multi-source overlap).
 * Canonical provenance for a Listing. Not Workspace-owned.
 * Not a WorkspaceDataConnection FK — connection authorizes use via
 * organizationId + providerKey match against ACTIVE connections.
 * Identity (no ambiguous NULLs):
 * UNIQUE(listingId, providerKey, providerListingKey)
 * providerListingKey is REQUIRED (PropTx = RESO ListingKey, not MlsNumber).
 * Primary contract:
 * At most one isPrimary=true per listingId (partial unique index in SQL).
 * Listing.organizationId / Listing.providerKey are DENORMALIZED copies of the
 * primary ListingSource only — ListingSource remains canonical lineage.
 * Do not insert preview/demo inventory. Do not auto-merge across boards.
 * feedKey intentionally omitted (IDX/VOW-style access classes are not source identity).
 */
model ListingSource {
  id                 String   @id @default(cuid())
  listingId          String
  /**
   * Null until RealEstateOrganization catalog row exists / attribution runs.
   */
  organizationId     String?
  /**
   * Integration/data-provider key (e.g. proptx). Distinct from organization.
   */
  providerKey        String
  /**
   * Durable provider-native listing id. REQUIRED.
   * PropTx/AMPRE: RESO ListingKey (mapListingKey) — NOT ListingId/MlsNumber.
   */
  providerListingKey String
  /**
   * MLS® / board display number as reported by this source.
   * PropTx: ListingId / MlsNumber (mapMlsNumber). Not globally unique alone.
   */
  sourceMlsNumber    String?
  /**
   * Exactly one primary source per Listing (enforced by partial unique index).
   * Primary drives denormalized Listing.organizationId + Listing.providerKey.
   */
  isPrimary          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  listing      Listing                 @relation(fields: [listingId], references: [id], onDelete: Cascade)
  organization RealEstateOrganization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@unique([listingId, providerKey, providerListingKey])
  @@index([listingId, isPrimary])
  @@index([organizationId, sourceMlsNumber])
  @@index([providerKey, providerListingKey])
  @@index([organizationId, providerKey])
}

