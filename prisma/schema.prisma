enum PartnerType {
  MORTGAGE
  LAWYER
  INSPECTOR
  OTHER
}

enum HandoffStatus {
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  CLOSED
}

model ReferralPartner {
