<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  MLS Fast Sync LaunchAgent. NOT installed by this change.

  Live Sync Mac repo: /Users/Ali/Houzzat-Canada
  Interval: 600s (10 minutes). Separate lock from com.houzzat.mls-sync.

  Do not copy onto a Mac without confirming the repo root exists.
  Do not change com.houzzat.mls-sync StartInterval (3600).
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.houzzat.mls-fast-sync</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>/Users/Ali/Houzzat-Canada/scripts/mac-mls-fast-sync.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>600</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>WorkingDirectory</key>
    <string>/Users/Ali/Houzzat-Canada</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>GOOGLE_MAPS_BILLING_ENABLED</key>
      <string>0</string>
      <key>GEOCODE_SKIP_GOOGLE</key>
      <string>1</string>
      <key>MLS_SYNC_MODE</key>
      <string>fast</string>
      <key>TYPESENSE_SYNC</key>
      <string>1</string>
      <key>HOME</key>
      <string>/Users/Ali</string>
      <key>PATH</key>
      <string>/usr/local/bin:/usr/local/Homebrew/bin:/usr/bin:/bin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/Ali/Library/Logs/houzzat/launchd-mls-fast-sync.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/Ali/Library/Logs/houzzat/launchd-mls-fast-sync.err.log</string>
    <key>ThrottleInterval</key>
    <integer>60</integer>
  </dict>
</plist>
