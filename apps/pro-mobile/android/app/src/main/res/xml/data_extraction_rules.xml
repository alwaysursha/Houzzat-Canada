<?xml version="1.0" encoding="utf-8"?>
<!--
  HouzzatPro: disable cloud/device transfer backups for the staff CRM WebView.
  API 31+ uses dataExtractionRules; fullBackupContent=false covers older APIs
  together with android:allowBackup="false" on the application tag.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
