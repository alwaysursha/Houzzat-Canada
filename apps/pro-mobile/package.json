{
  "name": "@houzzat/pro-mobile",
  "version": "2.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx test/mobile-v2-foundation.test.ts",
    "test:push-permission": "node --import tsx test/stage-5.11-android-notification-permission.test.ts && node --import tsx test/stage-5.11-push-registration.test.ts && node --import tsx test/stage-5.11-foreground-push-display.test.ts"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.0",
    "@react-native-community/datetimepicker": "^9.2.0",
    "@react-navigation/bottom-tabs": "7.2.0",
    "@react-navigation/native": "7.0.14",
    "@react-navigation/native-stack": "7.2.0",
    "react": "18.3.1",
    "react-native": "0.76.7",
    "react-native-safe-area-context": "5.0.0",
    "react-native-screens": "4.4.0",
    "react-native-webview": "13.12.5"
  },
  "devDependencies": {
    "@react-native-community/cli": "15.1.3",
    "@react-native/babel-preset": "0.76.7",
    "@react-native/community-cli-plugin": "0.76.7",
    "@react-native/metro-config": "0.76.7",
    "@types/react": "^18.3.18",
    "@types/react-native": "^0.73.0",
    "metro": "0.81.3",
    "metro-config": "0.81.3",
    "typescript": "^5.7.3"
  }
}
