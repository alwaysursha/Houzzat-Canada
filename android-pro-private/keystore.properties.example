# HouzzatPro upload keystore (NEW package — do NOT reuse consumer keystore).
# Copy to keystore.properties (gitignored) and fill in locally. Never commit secrets.
#
# Recommended: enable Play App Signing in Play Console, then upload with this
# upload key. Google holds the app signing key.
#
# Create once:
#   keytool -genkeypair -v \
#     -keystore houzzatpro-upload.keystore \
#     -alias houzzatpro \
#     -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=houzzatpro-upload.keystore
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=houzzatpro
keyPassword=YOUR_KEY_PASSWORD
