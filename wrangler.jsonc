{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "houzzat",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "houzzat.com", "custom_domain": true },
    { "pattern": "www.houzzat.com", "custom_domain": true }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "houzzat"
    }
  ],
  "vars": {
    "NEXTAUTH_URL": "https://houzzat.com",
    "NEXT_PUBLIC_SITE_URL": "https://houzzat.com",
    // Public wa.me destination — also set NEXT_PUBLIC_WHATSAPP_EXPERT at build
    // time (GitHub Actions) so client bundles can inline it.
    "NEXT_PUBLIC_WHATSAPP_EXPERT": "16472214949",
    // Temporary public gate — set to "1" to show Coming Soon to visitors
    "COMING_SOON": "0",
    // PropTx VOW — registered clients only until IDX is approved
    "LISTING_PROVIDER": "proptx",
    "PROPTX_FEED": "vow",
    "PROPTX_ENDPOINT_URL": "https://query.ampre.ca/odata/"
  }
}
