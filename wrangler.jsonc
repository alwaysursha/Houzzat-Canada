{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "houzzat",
  // Wraps OpenNext so listing RSC never reaches the Worker with Next-Router-State-Tree.
  "main": "cloudflare/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Keep workers.dev live until houzzat.com is attached in the Cloudflare dashboard
  // (Workers → houzzat → Domains & Routes). Do not add custom_domain routes here
  // until the zone is on this Cloudflare account — API attach fails otherwise.
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Stage 6.11C.3 — tenant Website Setup brand assets (houzzat.com host-bound OWNER).
  // Bucket must be created in Cloudflare before deploy; see Stage 6.11C.1/C.2 reports.
  "r2_buckets": [
    {
      "binding": "BRANDING_ASSETS",
      "bucket_name": "houzzatpro-branding-assets",
      "preview_bucket_name": "houzzatpro-branding-assets-preview"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "houzzat"
    }
  ],
  // Stage 5.12B — Browser Rendering PDF (optional binding).
  // Prefer enabling when account has Browser Rendering:
  //   "browser": { "binding": "BROWSER" }
  // Until then, set Worker secrets:
  //   CLOUDFLARE_ACCOUNT_ID
  //   CLOUDFLARE_BROWSER_RENDERING_API_TOKEN  (Browser Rendering — Edit)
  // Code falls back to REST /accounts/{id}/browser-rendering/pdf.
  // Extra CPU headroom for paid Workers (default 30s). Does not fix PropTx-on-SSR;
  // listing HTML still must stay light — this is a safety net only.
  "limits": {
    "cpu_ms": 60000
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  // Preserve Cloudflare dashboard plain vars that are NOT listed below.
  // Secrets are never deleted by deploy. Vars listed in `vars` are still
  // applied from this file on every deploy (source of truth for those keys).
  // Workspace SaaS scopes (READ/ROUTING/NOTIFICATION/TEAM/DUAL_WRITE) are
  // intentionally omitted so dashboard remains their runtime source of truth.
  "keep_vars": true,
  "vars": {
    "NEXTAUTH_URL": "https://houzzat.com",
    "NEXT_PUBLIC_SITE_URL": "https://houzzat.com",
    // Public wa.me destination — also set NEXT_PUBLIC_WHATSAPP_EXPERT at build
    // time (GitHub Actions) so client bundles can inline it.
    "NEXT_PUBLIC_WHATSAPP_EXPERT": "16472214949",
    // Temporary public gate — set to "1" to show Coming Soon to visitors
    "COMING_SOON": "0",
    // PropTx: IDX public browse + VOW for registered clients (sold/history)
    "LISTING_PROVIDER": "proptx",
    "PROPTX_FEED": "idx",
    "PROPTX_ENDPOINT_URL": "https://query.ampre.ca/odata/",
    // Typesense search index (keys via `wrangler secret put`)
    "TYPESENSE_PORT": "443",
    "TYPESENSE_PROTOCOL": "https",
    "TYPESENSE_COLLECTION": "listings",
    "TYPESENSE_AUTOCOMPLETE": "1",
    "TYPESENSE_SEARCH": "1",
    // Worker does not upsert — sync Mac / Actions use ADMIN key locally
    "TYPESENSE_SYNC": "0"
    // Workspace SaaS activation flags (READ / ROUTING / NOTIFICATION / TEAM /
    // DUAL_WRITE) stay OUT of wrangler vars. With keep_vars=true, Cloudflare
    // dashboard is the runtime source of truth so a deploy cannot reset them.
  }
}

