{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "houzzat",
  // Wraps OpenNext so listing RSC never reaches the Worker with Next-Router-State-Tree.
  "main": "cloudflare/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Keep workers.dev live until houzzat.com is attached in the Cloudflare dashboard
  // (Workers → houzzat → Domains & Routes). Do not add custom_domain routes here
  // until the zone is on this Cloudflare account — API attach fails otherwise.
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "houzzat"
    }
  ],
  // Extra CPU headroom for paid Workers (default 30s). Does not fix PropTx-on-SSR;
  // listing HTML still must stay light — this is a safety net only.
  "limits": {
    "cpu_ms": 60000
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "NEXTAUTH_URL": "https://houzzat.com",
    "NEXT_PUBLIC_SITE_URL": "https://houzzat.com",
    // Public wa.me destination — also set NEXT_PUBLIC_WHATSAPP_EXPERT at build
    // time (GitHub Actions) so client bundles can inline it.
    "NEXT_PUBLIC_WHATSAPP_EXPERT": "16472214949",
    // Temporary public gate — set to "1" to show Coming Soon to visitors
    "COMING_SOON": "0",
    // PropTx: IDX public browse + VOW for registered clients (sold/history)
    "LISTING_PROVIDER": "proptx",
    "PROPTX_FEED": "idx",
    "PROPTX_ENDPOINT_URL": "https://query.ampre.ca/odata/",
    // Typesense search index (keys via `wrangler secret put`)
    "TYPESENSE_PORT": "443",
    "TYPESENSE_PROTOCOL": "https",
    "TYPESENSE_COLLECTION": "listings",
    "TYPESENSE_AUTOCOMPLETE": "1",
    "TYPESENSE_SEARCH": "1",
    // Worker does not upsert — sync Mac / Actions use ADMIN key locally
    "TYPESENSE_SYNC": "0"
  }
}
