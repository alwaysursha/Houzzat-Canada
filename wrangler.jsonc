{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "houzzat",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Keep workers.dev live until houzzat.com is attached in the Cloudflare dashboard
  // (Workers → houzzat → Domains & Routes). Do not add custom_domain routes here
  // until the zone is on this Cloudflare account — API attach fails otherwise.
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "houzzat"
    }
  ],
  "vars": {
    "NEXTAUTH_URL": "https://houzzat.com",
    "NEXT_PUBLIC_SITE_URL": "https://houzzat.com",
    // Public wa.me destination — also set NEXT_PUBLIC_WHATSAPP_EXPERT at build
    // time (GitHub Actions) so client bundles can inline it.
    "NEXT_PUBLIC_WHATSAPP_EXPERT": "16472214949",
    // Temporary public gate — set to "1" to show Coming Soon to visitors
    "COMING_SOON": "0",
    // PropTx: IDX public browse + VOW for registered clients (sold/history)
    "LISTING_PROVIDER": "proptx",
    "PROPTX_FEED": "idx",
    "PROPTX_ENDPOINT_URL": "https://query.ampre.ca/odata/"
  }
}
