{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "houzzat",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Add houzzat.ca back after the domain is added to this Cloudflare account:
  // "routes": [{ "pattern": "houzzat.ca", "custom_domain": true }],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "houzzat"
    }
  ],
  "vars": {
    "NEXTAUTH_URL": "https://houzzat.teamalisyed.workers.dev",
    "NEXT_PUBLIC_SITE_URL": "https://houzzat.teamalisyed.workers.dev",
    // Public wa.me destination — also set NEXT_PUBLIC_WHATSAPP_EXPERT at build
    // time (GitHub Actions) so client bundles can inline it.
    "NEXT_PUBLIC_WHATSAPP_EXPERT": "16472214949",
    // Temporary public gate — set to "1" to show Coming Soon to visitors
    "COMING_SOON": "0"
  }
}
