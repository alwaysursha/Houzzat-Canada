{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Stage 6 infra correction — isolated HouzzatPRO SaaS/platform Worker
  // (standalone; no inheritance from wrangler.jsonc / tenant-canary).
  // First deploy: workers.dev only. Do NOT attach custom domains, wildcard
  // routes, or move houzzatpro.com / app.houzzatpro.com until approved.
  "name": "houzzatpro",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Stage 6.11C.1 — tenant Website Setup brand assets (hostname-bound OWNER uploads).
  // Bucket must be created in Cloudflare before deploy; see Stage 6.11C.1 report.
  "r2_buckets": [
    {
      "binding": "BRANDING_ASSETS",
      "bucket_name": "houzzatpro-branding-assets",
      "preview_bucket_name": "houzzatpro-branding-assets-preview"
    },
    {
      "binding": "CHAT_MEDIA",
      "bucket_name": "houzzatpro-chat-media",
      "preview_bucket_name": "houzzatpro-chat-media-preview"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "houzzatpro"
    }
  ],
  "limits": {
    "cpu_ms": 60000
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  // Preserve dashboard plain vars that are NOT listed below.
  // Secrets are never deleted by deploy. Vars listed in `vars` are applied
  // from this file on every deploy (source of truth for those keys).
  "keep_vars": true,
  "vars": {
    // Intended application bootstrap origin (Stage 3K.5.10.6 / Stage 6).
    // Intentionally omit NEXTAUTH_URL / AUTH_URL so Auth.js trustHost can
    // derive per-request origins once hosts are attached (same posture as canary).
    "NEXT_PUBLIC_SITE_URL": "https://app.houzzatpro.com",
    // Workspace/platform tenancy — required for {slug}.houzzatpro.com resolution.
    // Do NOT inherit houzzat legacy defaults (TENANT_* unset → legacy).
    "TENANT_DOMAIN_SCOPE": "workspace",
    "TENANT_BRANDING_SCOPE": "workspace",
    "TENANT_PUBLIC_LEAD_SCOPE": "workspace",
    "WORKSPACE_ROUTING_SCOPE": "workspace",
    "WORKSPACE_NOTIFICATION_SCOPE": "workspace",
    "WORKSPACE_READ_SCOPE": "workspace",
    "WORKSPACE_TEAM_SCOPE": "workspace",
    "TENANT_ADMIN_HOST_LOCK": "off",
    // Houzzat-only WhatsApp fallback (server). Tenant hosts must not consume this.
    "NEXT_PUBLIC_WHATSAPP_EXPERT": "16472214949",
    "COMING_SOON": "0",
    "LISTING_PROVIDER": "proptx",
    "PROPTX_FEED": "idx",
    "PROPTX_ENDPOINT_URL": "https://query.ampre.ca/odata/",
    "TYPESENSE_PORT": "443",
    "TYPESENSE_PROTOCOL": "https",
    "TYPESENSE_COLLECTION": "listings",
    "TYPESENSE_AUTOCOMPLETE": "1",
    "TYPESENSE_SEARCH": "1",
    "TYPESENSE_SYNC": "0"
    // Workspace SaaS activation flags stay OUT of wrangler vars (dashboard).
  }
}
