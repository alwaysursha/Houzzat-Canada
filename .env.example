DATABASE_URL="postgresql://user:password@localhost:5432/houzzat?sslmode=prefer"
DIRECT_URL="postgresql://user:password@localhost:5432/houzzat?sslmode=prefer"

AUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_URL="http://127.0.0.1:3000"
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:3000"

# Local tip: if you run Next on a non-3000 port (e.g. 3001), either update
# NEXTAUTH_URL to match OR comment NEXTAUTH_URL out (trustHost uses the request host).


GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Maps Platform (Places autocomplete + Routes drive time)
# 1) Enable Places API (New) AND Routes API on the project
# 2) On the API key → API restrictions, allow BOTH APIs (enabling on the
#    project alone is not enough if the key is restricted)
GOOGLE_MAPS_API_KEY=""

RESEND_API_KEY=""
EMAIL_FROM="Houzzat <noreply@houzzat.ca>"
EMAIL_ADMIN_TO="admin@houzzat.ca"

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

MAPBOX_TOKEN=""
NEXT_PUBLIC_MAPBOX_TOKEN=""

# mock (default) | proptx — keep mock until TRREB credentials are ready
LISTING_PROVIDER="mock"

# Optional — when set, property/area narratives use OpenAI; otherwise grounded templates
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Optional ads tracking (Ad Studio attribution still works via UTM without these)
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GOOGLE_ADS_ID=""

# WhatsApp via Twilio (optional — stubs to console when unset)
TWILIO_WHATSAPP_FROM=""

# Public WhatsApp number for “Ask the Expert” on listing pages (digits only, country code included)
# Example: 14165550100
NEXT_PUBLIC_WHATSAPP_EXPERT=""

# Stripe (owner listing checkout — stubbed until go-live)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
