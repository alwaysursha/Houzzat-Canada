DATABASE_URL="postgresql://user:password@localhost:5432/houzzat?sslmode=prefer"
DIRECT_URL="postgresql://user:password@localhost:5432/houzzat?sslmode=prefer"

AUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_URL="http://127.0.0.1:3000"
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:3000"

# Local tip: if you run Next on a non-3000 port (e.g. 3001), either update
# NEXTAUTH_URL to match OR comment NEXTAUTH_URL out (trustHost uses the request host).


GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Maps Platform
# The API key alone does not enable billing. Each product has its own switch.
GOOGLE_MAPS_API_KEY=""
# Leave 0. This must stay off so catalogue geocoding and Places stay unpaid.
GOOGLE_MAPS_BILLING_ENABLED="0"
# Catalogue pin repair. Both must be set to use Google Geocoding / Text Search.
GEOCODE_SKIP_GOOGLE="1"
# GEOCODE_USE_GOOGLE="0"
# Address suggestions stay on free Photon.
GOOGLE_PLACES_AUTOCOMPLETE="0"
# Off-market address search + /property profiles (Phase 2–3). Default OFF.
# When 1: address select resolves once; ACTIVE_LISTING → listing URL;
# NO_ACTIVE_LISTING_FOUND → /property/{slug}; UNKNOWN → Search Nearby.
# Do not enable in production without product approval.
# NEXT_PUBLIC_OFF_MARKET_PROPERTY_SEARCH_ENABLED="0"

# Natural-language search parser v2 (deterministic). Default OFF.
# When 1: improved parseSearchQuery (multi-city, apartments, baths, generic homes).
# When 0/unset: legacy parseSearchQuery behavior unchanged.
# NEXT_PUBLIC_NL_SEARCH_PARSER_V2="0"

# Drive time only, for a signed-in save. Cached and capped at 9,000 calls
# a Pacific month (the free Routes allowance is 10,000).
GOOGLE_ROUTES_ENABLED="1"

RESEND_API_KEY=""
# Svix signing secret from Resend → Webhooks (email.opened / email.clicked)
RESEND_WEBHOOK_SECRET=""
# Fallback from-address (used if notify/alerts not set)
EMAIL_FROM="Houzzat <noreply@houzzat.com>"
# Transactional: verify, welcome, password, agent 1:1, shortlist
EMAIL_FROM_NOTIFY="Houzzat <notify@houzzat.com>"
# Alerts / marketing: price drops, sold, just listed, newsletters
EMAIL_FROM_ALERTS="Houzzat Alerts <alerts@houzzat.com>"
EMAIL_ADMIN_TO="admin@houzzat.com"
# Stage 6.6C — HouzzatPRO Book a Demo notifications (server-only; never NEXT_PUBLIC_*)
HOUZZATPRO_DEMO_NOTIFICATION_EMAIL=""
# Optional HouzzatPRO From (must use a Resend-verified domain; do not invent @houzzatpro.com)
HOUZZATPRO_EMAIL_FROM="HouzzatPRO <notify@houzzat.com>"

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# JSON map of Twilio subaccount SID → Auth Token.
# Outbound sendSms() authenticates as that subaccount. Also used for
# webhook signatures. Never store these in Postgres. Example: {"ACxxx":"auth-token"}
TWILIO_SUBACCOUNT_AUTH_TOKENS=""
# Optional Twilio webhook SharedKey secret (X-Twilio-Signature-Key-Sid).
TWILIO_WEBHOOK_SHARED_KEY=""

MAPBOX_TOKEN=""
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Optional. CARTO Voyager raster tiles now require a key (otherwise they
# watermark "API KEY REQUIRED"). Request at https://carto.com/basemaps/apikey
# If unset, maps use OpenFreeMap (OSM vector, no key).
NEXT_PUBLIC_CARTO_API_KEY=""

# mock (default) | proptx — use proptx only after a healthy MLS sync
LISTING_PROVIDER="mock"

# PropTx / AMPRE RESO Web API — never commit real secrets.
# Visitor listings = IDX Token. Sold/history for clients = optional VOW Token.
PROPTX_ENDPOINT_URL="https://query.ampre.ca/odata/"
# IDX (required for visitor access) — Token ID + Bearer from your IDX agreement
PROPTX_BEARER_TOKEN=""
PROPTX_TOKEN_ID=""
# Optional aliases (same as above):
# PROPTX_IDX_BEARER_TOKEN=""
# PROPTX_IDX_TOKEN_ID=""
# Optional VOW Token (separate agreement) — keeps sold prices fresh for registered clients
# PROPTX_VOW_BEARER_TOKEN=""
# PROPTX_VOW_TOKEN_ID=""
# Optional — header name for Token ID (default TokenId)
# PROPTX_TOKEN_ID_HEADER="TokenId"
# Site mode: idx = guests browse active listings; vow = login-gated entire MLS
PROPTX_FEED="idx"
# Optional shared secret for small admin HTTP sync (capped pages on Workers):
# POST /api/admin/mls/sync
# Header: x-mls-sync-secret: <value>  or  Authorization: Bearer <value>
MLS_SYNC_SECRET=""
# Daily digests cron (Bearer or x-digest-cron-secret). Falls back to CRON_SECRET / MLS_SYNC_SECRET.
DIGEST_CRON_SECRET=""
DIGEST_CRON_URL="https://houzzat.com/api/cron/digests"

# Production MLS Sync runs in GitHub Actions (not Worker HTTP). Required secrets:
#   DATABASE_URL, DIRECT_URL (optional),
#   PROPTX_ENDPOINT_URL, PROPTX_BEARER_TOKEN, PROPTX_TOKEN_ID  (IDX Token)
# Optional for sold enrichment: PROPTX_VOW_BEARER_TOKEN, PROPTX_VOW_TOKEN_ID

# Optional extra cities (comma-separated). Appended to default list in
# src/lib/proptx/sync-cities.ts
# MLS_SYNC_CITIES="Sarnia,Woodstock"

# Optional — when set, property/area narratives use OpenAI; otherwise grounded templates
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Unused. Tenant website tags are WorkspaceTracking rows, not deployment env.
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GOOGLE_ADS_ID=""

# Firebase Cloud Messaging (native lock-screen push). Paste the full
# service-account JSON as one line. Never commit the downloaded key file.
FIREBASE_SERVICE_ACCOUNT=""

# WhatsApp via Twilio (optional — stubs to console when unset)
TWILIO_WHATSAPP_FROM=""

# Public WhatsApp number for “Ask the Expert” on listing pages (digits only, country code included)
# Example: 14165550100
NEXT_PUBLIC_WHATSAPP_EXPERT=""

# Temporary public site gate (1/true = Coming Soon page for visitors)
# Set to 0 when ready to open the full website
COMING_SOON="0"

# Stripe — HouzzatPRO SaaS Embedded Checkout (Stage 6.8B) + owner listing stub
# Server-only secrets — never NEXT_PUBLIC for secret/webhook keys.
# Publishable key is required client-side to mount Embedded Checkout.
# Commercial authority remains accepted CommercialOffer / OfferAcceptance (not Stripe Price IDs).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Typesense Cloud (dedicated search index) — never commit real keys
# Admin key: scripts + sync upserts. Search key: API routes only.
# Production: Worker secrets (search) + GitHub secrets (sync). Sync Mac:
#   bash scripts/mac-apply-typesense-env.sh /Users/Ali/Houzzat-Canada
TYPESENSE_HOST=""
TYPESENSE_PORT="443"
TYPESENSE_PROTOCOL="https"
TYPESENSE_ADMIN_API_KEY=""
TYPESENSE_SEARCH_API_KEY=""
TYPESENSE_COLLECTION="listings"
# 1 = use Typesense for /api/listings/autocomplete (falls back to Neon on error)
TYPESENSE_AUTOCOMPLETE="0"
# 1 = use Typesense for /api/listings/search (falls back to Neon on error / unsupported filters)
TYPESENSE_SEARCH="0"
# Keep Typesense updated on MLS upsert/media (auto-on when SEARCH/AUTOCOMPLETE=1; set 0 to disable)
TYPESENSE_SYNC="1"

# Cloudflare Turnstile — HouzzatPRO Book a Demo (Stage 6.6B.1)
# Site key is public (browser). Secret is server-only — never NEXT_PUBLIC / never commit real values.
# Local/automated testing: use Cloudflare dummy keys from
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
# TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
# Stage 6.11C.1 — public base URL for R2 branding objects (no trailing slash).
# Required in production when BRANDING_ASSETS R2 binding is present on Workers:
#   houzzat, houzzatpro, houzzat-tenant-canary
# Example (set in Cloudflare Worker vars — do not commit real values):
# BRANDING_ASSETS_PUBLIC_BASE_URL="https://branding-assets.example.com"
# Vercel-only S3-compatible access to the branding R2 bucket (Workers keep the binding).
# These keys must authorize Object Read & Write on houzzatpro-branding-assets.
# Do NOT reuse chat-media-only tokens here — branding uploads will 403 AccessDenied.
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# R2_BUCKET_NAME="houzzatpro-branding-assets"
#
# Private chat media (voice notes) — NEVER use BRANDING_ASSETS / public CDN URLs.
# Cloudflare Workers: CHAT_MEDIA R2 binding (private bucket, no public access).
# Vercel / Node: dedicated chat credentials (preferred) so branding key rotation
# cannot break voice notes and vice versa. Both dedicated vars must be set together;
# setting only one fails closed (no silent mix with branding secrets).
# CHAT_MEDIA_R2_BUCKET_NAME="houzzatpro-chat-media"
# CHAT_MEDIA_R2_ACCESS_KEY_ID=""
# CHAT_MEDIA_R2_SECRET_ACCESS_KEY=""
# Optional override when chat uses a different account/jurisdiction endpoint:
# CHAT_MEDIA_R2_S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# Legacy fallback (both dedicated chat key vars absent): shared R2_ACCESS_KEY_ID /
# R2_SECRET_ACCESS_KEY + R2_S3_ENDPOINT still work, but the token must then be
# scoped to BOTH branding and chat-media buckets.
# Local/dev without R2: files land under private/chat-media/ (not public/).

# Vercel CMA PDF — Cloudflare Browser Rendering REST (Workers keep BROWSER binding).
# Token permission: Account → Browser Rendering — Edit. Never NEXT_PUBLIC_*.
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_BROWSER_RENDERING_API_TOKEN=""
# Optional fallback if the dedicated token is unset (same Edit permission):
# CLOUDFLARE_API_TOKEN=""
